# N2 molecule in a box, 2x2x2 shifted k-mesh: cheap RDMFT smoke test.
# DS1: LDA ground state (WFK). DS2: Hartree-Fock SCF (Fock operator, ixc 40).
# DS3: RDMFT (optdriver 11) with the GNOF functional, starting from the HF orbitals.
ndtset 3

acell 3*4 angstrom
ntypat 1
znucl 7
natom 2
typat 1 1
xcart -0.55 0 0  0.55 0 0 angstrom
nsym 1
istwfk *1
pp_dirpath "$ABI_PSPDIR"
pseudos "Psdj_nc_sr_04_pw_std_psp8/N.psp8"

ecut 4
nband 8
kptopt 2
ngkpt 2 2 2
nshiftk 1
shiftk 0.5 0.5 0.5
prtwf 1
tolvrs 1e-10
nstep 60

ixc1 11

ixc2 40
fock_icutcoul2 3
getwfk2 -1
iscf2 7
diemix2 0.3
diemac2 1.0

optdriver3 11
ixc3 40
fock_icutcoul3 3
getwfk3 -1
rdmft_selfint3 1
rdmft_tr_reduce3 0
rdmft_functional3 24
rdmft_nocc_act3 1
rdmft_ncoupl3 2

#%%<BEGIN TEST_INFO>
#%% [setup]
#%% executable = abinit
#%% [files]
#%% files_to_test =
#%%   t85.abo, tolnlines = 10, tolabs = 1.1e-04, tolrel = 1.0e-03
#%% [paral_info]
#%% max_nprocs = 1
#%% [extra_info]
#%% authors = M. Rodriguez-Mayorga
#%% keywords = RDMFT, Fock
#%% description =
#%%   N2 molecule in a box, 2x2x2 shifted k-mesh, cheap test of the RDMFT driver (optdriver 11).
#%%   DS1: LDA, DS2: Hartree-Fock, DS3: RDMFT with the GNOF functional (rdmft_functional 24).
#%%<END TEST_INFO>
